# -------------------------------------------------------------
# tardis project
# -------------------------------------------------------------
function start-tardis-server-refresh {
    gw --stop
    # Wipe the DB: down the SAME stack we bring up, WITH -v to remove the postgres volume.
    # (Was `acd` = `docker compose -f app.yml down` — wrong stack + no -v — so it never wiped.)
    docker compose -f src/main/docker/local-env.yml down -v
    docker compose -f src/main/docker/local-env.yml up -d
    gw
}
function start-tardis-server {
    gw --stop
    # docker-compose -f src/main/docker/postgresql.yml up -d
    docker-compose -f src/main/docker/local-env.yml up -d
    gw
}

alias acub="start-tardis-server"
alias acrb="start-tardis-server-refresh"
alias ast="npm run start"

alias nrd="npm run dev"
alias nrs="npm run start"

